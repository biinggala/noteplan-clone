# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Claude Code project memory
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tauri 업데이트 서명 개인키 (절대 커밋 금지 — 실제 키는 ~/.tauri 에 있음)
*.key
*.key.pub
