{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NotePlan Clone",
  "version": "0.16.8",
  "identifier": "com.biinggala.noteplan-clone",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:static"
  },
  "app": {
    "windows": [
      {
        "title": "NotePlan Clone",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#1a1a1a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["noteplan"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/biinggala/noteplan-clone/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERUVDM0I2OUYzOEUwQUQKUldTdDREaWZ0c1B1emN0ZGtwYzNwaXZwS0d2emovTW9US0I4VTlxUkNpOElKeWQwT1hVU1hENzMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
